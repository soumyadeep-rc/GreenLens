# ==========================================
# GreenLens Backend Environment Variables
# ==========================================

# --- 1. Server & Core ---
PORT=8000
CORS_ORIGIN=http://localhost:3000
ML_API_URL=http://127.0.0.1:8001

# --- 2. Database (MongoDB) ---
# Replace with your local MongoDB URI or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017
# Do not change this unless you update src/constants.js
DB_NAME=GreenLens

# --- 3. Authentication (Clerk) ---
# Get these from your Clerk dashboard (make sure to use the "Test Mode" keys for local dev)
CLERK_PUBLISHABLE_KEY=pk_test_you_should_replace_this_with_your_own_key
CLERK_SECRET_KEY=sk_test_you_should_replace_this_with_your_own_key

# --- 4. Web3 / Blockchain ---
# Get this from Alchemy or Infura (e.g., Sepolia Testnet RPC URL)
ALCHEMY_URL=your_alchemy_or_infura_rpc_url_here
# WARNING: ONLY USE A DEV/TESTNET WALLET PRIVATE KEY HERE. NEVER YOUR MAINNET WALLET.
PRIVATE_KEY=your_dev_wallet_private_key_here
# The address where your GreenToken smart contract is deployed
CONTRACT_ADDRESS=your_deployed_contract_address_here

# --- 5. Media Storage (Cloudinary) ---
# Your package.json has Cloudinary, likely for the plantation photos. Get this from your Cloudinary dashboard.
CLOUDINARY_URL=your_cloudinary_url_here